# Literal KEY=value; no quotes. Never commit the actual .env.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: existing state/telegram_group_chat.json is used if empty.
TELEGRAM_GROUP_CHAT_ID=
TELETHON_SESSION_PATH=/var/lib/hotdeal-live/hotdeal_session.session
JIRUM_DATA_DIR=/var/lib/hotdeal-live
# false = receive/store in separate shadow DB, no automatic Bot API sends.
JIRUM_LIVE_ENABLED=false
# Optional real-time GitHub Actions trigger from live @jirum watcher.
# Keep disabled until code is deployed to the existing server and the
# fine-grained GitHub PAT (hotdeal-bot repository: Actions write) is stored
# ONLY in the server's protected environment file.
JIRUM_GITHUB_DISPATCH_ENABLED=false
JIRUM_GITHUB_DISPATCH_TOKEN=
